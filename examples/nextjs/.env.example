# mock or stripe
ACCOUNT_EVALUATIONS_MODE=mock
BETTER_AUTH_URL=http://localhost:3000
# Generate a new value: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
DATABASE_PATH=./data/auth.db

# Stripe mode: matching keys from one account.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# enforce blocks scores >= 75; monitor only observes.
ACCOUNT_EVALUATIONS_POLICY=enforce
